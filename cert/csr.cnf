[req]
default_bits       = 2048
prompt             = no
default_hash       = sha256
distinguished_name = req_distinguished_name
req_extensions     = req_ext

[req_distinguished_name]
commonName         = samsungads.com

[req_ext]
subjectAltName = @alt_names

[alt_names]
DNS.1 = *.samsungads.com
DNS.2 = *.adgrx.com
DNS.3 = *.adsmeasurement.com
DNS.4 = *.samsungqbe.com
DNS.5 = *.omtrdc.net
DNS.6 = *.conviva.com
DNS.7 = *.imrworldwide.com
DNS.8 = *.samsungcloudsolution.net