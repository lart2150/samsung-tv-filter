{
  "name": "tv-filter",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Koa reverse proxy that blocks / trims Samsung TV ads, home-screen rows and trackers (port of tools/tv_block.py)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fix": "biome check --write ."
  },
  "dependencies": {
    "koa": "^3.2.1",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/koa": "^3.0.3",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
